#!/bin/bash
# One-way mirror of a home directory to Google Drive via rclone.
# Run by the gdrive-backup.timer/.service systemd units, or manually /
# on-click from the bar widget. Writes state to $XDG_STATE_HOME/gdrive-backup
# for the gdrive-backup bar widget to read.
#
# This is a MIRROR: files deleted locally are deleted from the remote too
# (rclone's `sync`, not `copy`). Google Drive moves them to its own Trash
# rather than purging immediately, but don't rely on that as a safety net.
#
# Override via env (e.g. in gdrive-backup.env next to this script, picked
# up by the systemd unit's EnvironmentFile=):
#   GDRIVE_BACKUP_SOURCE=~/Documents
#   GDRIVE_BACKUP_REMOTE=gdrive-boss:doc-backup
#   GDRIVE_BACKUP_EXCLUDE=/path/to/other.exclude
set -uo pipefail

plugin_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/gdrive-backup"
mkdir -p "$state_dir"

source_dir="${GDRIVE_BACKUP_SOURCE:-$HOME}"
# Namespaced by hostname so multiple machines can share one Drive remote
# without overwriting each other's backup.
remote="${GDRIVE_BACKUP_REMOTE:-gdrive-boss:home-backup/$(hostname)}"
exclude_file="${GDRIVE_BACKUP_EXCLUDE:-$plugin_dir/gdrive-backup.exclude}"

lockfile="$state_dir/sync.lock"
status_file="$state_dir/status.json"
log_file="$state_dir/last-run.log"
live_log="$state_dir/current-run.log" # progress while a run is in flight; read by the widget
git_info_name=".gdrive-backup-git-info"

exec 200>"$lockfile"
if ! flock -n 200; then
  echo "gdrive-backup: sync already in progress, skipping this run" >>"$log_file"
  exit 0
fi

# Stamp every git repo under the source tree with its origin remote and
# current branch. The exclude list drops .git/** (history isn't worth
# mirroring), so this small file is the only record of what a project
# directory was, once it's restored from a bare working-tree copy.
stamp_git_repos() {
  local gitdir repo_dir remote branch info_file
  while IFS= read -r -d '' gitdir; do
    repo_dir="$(dirname "$gitdir")"
    remote="$(git -C "$repo_dir" remote get-url origin 2>/dev/null || true)"
    branch="$(git -C "$repo_dir" branch --show-current 2>/dev/null || true)"
    [[ -z "$remote" && -z "$branch" ]] && continue
    info_file="$repo_dir/$git_info_name"
    printf 'remote: %s\nbranch: %s\n' "$remote" "$branch" >"$info_file" 2>/dev/null
    # Keep it out of `git status` without touching the repo's own .gitignore.
    grep -qxF "$git_info_name" "$gitdir/info/exclude" 2>/dev/null \
      || echo "$git_info_name" >>"$gitdir/info/exclude" 2>/dev/null
  done < <(find "$source_dir" \
    \( -name node_modules -o -name venv -o -name __pycache__ -o -name .cache \) -prune \
    -o -type d -name .git -print0 2>/dev/null)
}
stamp_git_repos

# Both this script and the widget's own status-file reader are hand-rolled
# (no jq dependency, matching the rest of this repo), so the message can't
# contain a literal '"' or '\' — the widget's naive parser can't tell an
# escaped quote from a field terminator. Swap quotes for readable single
# quotes and drop backslashes instead of JSON-escaping them.
sanitize() {
  local s="$1"
  s="${s//$'\n'/ }"
  s="${s//\"/\'}"
  s="${s//\\/}"
  printf '%s' "$s"
}

# Append straight to live_log (not buffered in a variable) so the widget
# can tail it for progress while a long sync is still running.
: >"$live_log"
rclone sync "$source_dir" "$remote" \
    --exclude-from "$exclude_file" \
    --stats 5s --stats-one-line -v >>"$live_log" 2>&1
rclone_exit=$?

output="$(cat "$live_log")"
mv -f "$live_log" "$log_file"

if [[ $rclone_exit -eq 0 ]]; then
  status="ok"
  summary=$(printf '%s\n' "$output" | tail -1 | sed -E 's#^[0-9/]+ [0-9:]+ [A-Z]+ *: *##')
else
  status="error"
  summary=$(printf '%s\n' "$output" | tail -5 | tr '\n' ' ')
fi

now=$(date +%s)
if [[ "$status" == "ok" ]]; then
  last_success="$now"
else
  # Preserve the previous last-success time across a failed run.
  last_success=$(grep -o '"last_success_epoch":[0-9]*' "$status_file" 2>/dev/null | grep -o '[0-9]*' || true)
fi

message="$(sanitize "$summary")"
remote_esc="$(sanitize "$remote")"

cat >"$status_file" <<EOF
{"status":"$status","last_attempt_epoch":$now,"last_success_epoch":${last_success:-null},"message":"$message","remote":"$remote_esc"}
EOF

[[ "$status" == "ok" ]]
