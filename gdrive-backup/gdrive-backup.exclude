# rclone exclude patterns for gdrive-backup, relative to the sync source
# (GDRIVE_BACKUP_SOURCE, $HOME by default). One pattern per line; rclone
# glob syntax: https://rclone.org/filtering/
#
# Edit this file freely — it's live (symlinked, not copied) once installed.

# Top-level dotfiles/dotdirs (.config, .cache, .mozilla, .ssh, .bashrc, …)
# — app config, caches, and credentials, not treated as backup data here.
# Anchored to the source root (leading /), so nested repo dirs like
# Projects/foo/.git are untouched by this and handled below instead.
/.*
/.*/**

# Regenerable build/dependency junk, wherever it turns up in the tree
.git/**
node_modules/**
venv/**
__pycache__/**

# Skipped by request — often just re-fetchable clutter
Downloads/**

# Large binary blobs not worth mirroring to Drive
*.iso
*.img
*.qcow2
